<Window x:Class="WPF_OpenStreetmap_Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_OpenStreetmap_Editor"
        mc:Ignorable="d"
        Title="WPF OpenStreetmap Editor" Height="1080" Width="1920" KeyDown="Window_KeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <!-- 顶部菜单行：先定义行（RowDefinitions），第1行为菜单，第2行为小按钮行，第3行为主内容 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" MinHeight="28" Padding="2" VerticalAlignment="Top">
            <Menu.ItemContainerStyle>
                <Style TargetType="{x:Type MenuItem}">
                    <Setter Property="Padding" Value="7,2" />
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </Menu.ItemContainerStyle>
            <MenuItem Header="文件(_F)">
                <MenuItem Header="新建" Click="New_Click" />
                <MenuItem Header="打开" Click="Open_Click" />
            </MenuItem>
            <MenuItem Header="编辑(_E)">
                <MenuItem Header="显示" Click="Show_Click" />
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem Header="显示" Click="Show_Click" />
            </MenuItem>
            <MenuItem x:Name="ImageryMenuItem" Header="影像(_I)">
                <MenuItem Header="影像选项..." Click="Settings_Click" />
                <Separator />
            </MenuItem>
            <MenuItem Header="项目(_P)">
                <MenuItem Header="显示" Click="Show_Click" />
            </MenuItem>
            <MenuItem Header="工具(_T)">
                <MenuItem Header="图层" Click="Layer_Click" />
                <MenuItem Header="设置" Click="Settings_Click" />
            </MenuItem>
            <MenuItem Header="窗口(_W)">
                <MenuItem Header="显示" Click="Show_Click" />
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="显示" Click="Show_Click" />
            </MenuItem>
        </Menu>

        <!-- 在菜单下再加一行小的正方形按钮 T1..T9 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Height="44" VerticalAlignment="Top" Background="Transparent" Margin="4,4,4,4">
            <Button Content="T1" Width="36" Height="36" Margin="2" Background="Transparent" BorderThickness="0" Foreground="Black"/>
            <Button Content="T2" Width="36" Height="36" Margin="2" Background="Transparent" BorderThickness="0" Foreground="Black"/>
            <Button Content="T3" Width="36" Height="36" Margin="2" Background="Transparent" BorderThickness="0" Foreground="Black"/>
            <Button Content="T4" Width="36" Height="36" Margin="2" Background="Transparent" BorderThickness="0" Foreground="Black"/>
            <Button Content="T5" Width="36" Height="36" Margin="2" Background="Transparent" BorderThickness="0" Foreground="Black"/>
            <Button Content="T6" Width="36" Height="36" Margin="2" Background="Transparent" BorderThickness="0" Foreground="Black"/>
            <Button Content="T7" Width="36" Height="36" Margin="2" Background="Transparent" BorderThickness="0" Foreground="Black"/>
            <Button Content="T8" Width="36" Height="36" Margin="2" Background="Transparent" BorderThickness="0" Foreground="Black"/>
            <Button Content="T9" Width="36" Height="36" Margin="2" Background="Transparent" BorderThickness="0" Foreground="Black"/>
        </StackPanel>

        <!-- 主内容区：分为左侧工具栏、中间主区、右侧输出区 -->
        <Grid Grid.Row="2" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- 左侧垂直正方形按钮 T1..T9 -->
            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Top" Margin="4">
                <Button Content="T1" Width="44" Height="44" Margin="2" Background="Transparent" BorderThickness="0" Foreground="Black"/>
                <Button Content="T2" Width="44" Height="44" Margin="2" Background="Transparent" BorderThickness="0" Foreground="Black"/>
                <Button Content="T3" Width="44" Height="44" Margin="2" Background="Transparent" BorderThickness="0" Foreground="Black"/>
                <Button Content="T4" Width="44" Height="44" Margin="2" Background="Transparent" BorderThickness="0" Foreground="Black"/>
                <Button Content="T5" Width="44" Height="44" Margin="2" Background="Transparent" BorderThickness="0" Foreground="Black"/>
                <Button Content="T6" Width="44" Height="44" Margin="2" Background="Transparent" BorderThickness="0" Foreground="Black"/>
                <Button Content="T7" Width="44" Height="44" Margin="2" Background="Transparent" BorderThickness="0" Foreground="Black"/>
                <Button Content="T8" Width="44" Height="44" Margin="2" Background="Transparent" BorderThickness="0" Foreground="Black"/>
                <Button Content="T9" Width="44" Height="44" Margin="2" Background="Transparent" BorderThickness="0" Foreground="Black"/>
            </StackPanel>

            <!-- 中间主区域：包含 URL 输入和地图渲染区域 -->
            <Grid Grid.Column="1" Background="WhiteSmoke">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,6,0">图源:</TextBlock>
                    <TextBlock x:Name="ActiveSourceTextBlock" MinWidth="220" MaxWidth="420" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" Margin="8,0,6,0">缩放:</TextBlock>
                    <TextBox x:Name="ZoomTextBox" Width="48" VerticalAlignment="Center" Text="2" IsReadOnly="True" HorizontalContentAlignment="Center" />
                    <Button x:Name="ZoomInButton" Content="+" Width="28" Height="22" Margin="4,0,0,0" Click="ZoomIn_Click" />
                    <Button x:Name="ZoomOutButton" Content="-" Width="28" Height="22" Margin="2,0,0,0" Click="ZoomOut_Click" />
                    <TextBlock x:Name="ZoomLimitTextBlock" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="DimGray" />
                    <Button Content="设置" Margin="10,0,0,0" Padding="10,2" Click="Settings_Click" />
                </StackPanel>

                <!-- 双层 Canvas 渲染：缩放旧画面时，新瓦片在透明前景层异步加载 -->
                <Border Grid.Row="1" Margin="6" BorderBrush="LightGray" BorderThickness="1">
                    <Grid x:Name="MapViewport"
                          Background="LightGray"
                          ClipToBounds="True"
                          Focusable="True"
                          UseLayoutRounding="True"
                          SnapsToDevicePixels="True"
                          RenderOptions.BitmapScalingMode="NearestNeighbor"
                          RenderOptions.EdgeMode="Aliased"
                          MouseWheel="MapCanvas_MouseWheel"
                          MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown"
                          MouseLeftButtonUp="MapCanvas_MouseLeftButtonUp"
                          MouseMove="MapCanvas_MouseMove"
                          SizeChanged="MapViewport_SizeChanged">
                        <Grid x:Name="MapLayerHost"
                              IsHitTestVisible="False"
                              UseLayoutRounding="True"
                              SnapsToDevicePixels="True"
                              RenderOptions.BitmapScalingMode="NearestNeighbor"
                              RenderOptions.EdgeMode="Aliased" />
                        <Border x:Name="AttributionBorder"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="6"
                                Padding="5,2"
                                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <TextBlock x:Name="AttributionTextBlock"
                                       FontSize="12"
                                       MaxWidth="{Binding ActualWidth, ElementName=MapViewport}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 右侧输出区：上表格（DataGrid），下编辑视图（TextBox 模拟文件编辑） -->
            <Grid Grid.Column="2" Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="LightGray" BorderThickness="1" CornerRadius="2" Background="White">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="8,6,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="图层" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="移除" Padding="8,1" Click="RemoveImageLayer_Click" />
                        </Grid>
                        <ListBox x:Name="LayerListBox"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 SelectionChanged="LayerListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0"
                                                     GroupName="PrimaryMapLayer"
                                                     IsChecked="{Binding IsPrimary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalAlignment="Center"
                                                     ToolTip="主图层"
                                                     Click="PrimaryLayer_Click" />
                                        <Button Grid.Column="1"
                                                Content="{Binding VisibilityLabel}"
                                                Padding="6,1"
                                                MinWidth="44"
                                                Margin="6,0,0,0"
                                                Click="LayerVisibilityButton_Click" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="8,0,8,0" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding KindLabel}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="80"
                                                   Foreground="DimGray" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1"
                              Height="6"
                              HorizontalAlignment="Stretch"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              Background="LightGray" />

                <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="1" CornerRadius="2" Background="White" Margin="0,6,0,0">
                    <TextBox Text="文件/编辑 区域（占位）" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="White" BorderThickness="0"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
