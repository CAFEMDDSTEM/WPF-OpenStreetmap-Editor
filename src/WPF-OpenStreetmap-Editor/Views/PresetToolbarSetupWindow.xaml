<Window x:Class="WPF_OpenStreetmap_Editor.Views.PresetToolbarSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:WPF_OpenStreetmap_Editor.Services"
        xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        Title="{services:Loc PresetToolbar.Title}"
        Height="580"
        Width="800"
        MinHeight="420"
        MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBrush}"
        Foreground="{DynamicResource Theme.TextBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{services:Loc PresetToolbar.Description}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Theme.MutedTextBrush}"
                   Margin="0,0,0,10" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{services:Loc PresetToolbar.Presets}" Margin="0,0,0,4" />
                <TreeView x:Name="PresetTree"
                          Grid.Row="1"
                          BorderBrush="{DynamicResource Theme.BorderBrush}"
                          BorderThickness="1"
                          SelectedItemChanged="PresetTree_SelectedItemChanged" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="PinGroupButton"
                            Content="{services:Loc PresetToolbar.PinGroup}"
                            IsEnabled="False"
                            Click="PinGroup_Click"
                            Margin="0,0,6,0" />
                    <Button x:Name="PinItemButton"
                            Content="{services:Loc PresetToolbar.PinItem}"
                            IsEnabled="False"
                            Click="PinItem_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{services:Loc PresetToolbar.Pinned}" Margin="0,0,0,4" />
                <ListBox x:Name="PinnedListBox"
                         Grid.Row="1"
                         BorderBrush="{DynamicResource Theme.BorderBrush}"
                         BorderThickness="1"
                         DisplayMemberPath="Display"
                         SelectionChanged="PinnedListBox_SelectionChanged" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="RemoveButton"
                            Content="{services:Loc Common.Remove}"
                            IsEnabled="False"
                            Click="Remove_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="{services:Loc Common.Save}"
                    IsDefault="True"
                    Click="Save_Click"
                    Margin="0,0,6,0" />
            <Button Content="{services:Loc Common.Cancel}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
