<Window x:Class="WPF_OpenStreetmap_Editor.Views.OsmDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:WPF_OpenStreetmap_Editor.Controls"
        xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        Title="下载 OpenStreetMap 数据"
        Width="1000"
        Height="720"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBrush}"
        Foreground="{DynamicResource Theme.TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="12,10">
            <TextBlock Text="OpenStreetMap 标准地图"
                       FontSize="15"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="ZoomTextBlock"
                       DockPanel.Dock="Right"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Theme.MutedTextBrush}" />
        </DockPanel>

        <Border Grid.Row="1"
                Margin="12,0"
                BorderBrush="{DynamicResource Theme.BorderBrush}"
                BorderThickness="1">
            <Grid x:Name="MapViewport"
                  ClipToBounds="True"
                  Focusable="True"
                  Cursor="Cross"
                  Background="{DynamicResource Theme.MapBackgroundBrush}"
                  automation:AutomationProperties.Name="OSM 下载范围地图"
                  MouseLeftButtonDown="MapViewport_MouseLeftButtonDown"
                  MouseLeftButtonUp="MapViewport_MouseLeftButtonUp"
                  MouseRightButtonDown="MapViewport_MouseRightButtonDown"
                  MouseRightButtonUp="MapViewport_MouseRightButtonUp"
                  MouseMove="MapViewport_MouseMove"
                  MouseWheel="MapViewport_MouseWheel"
                  SizeChanged="MapViewport_SizeChanged">
                <controls:TileLayerElement x:Name="TileLayer" IsHitTestVisible="False" />
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="SelectionRectangle"
                            Visibility="Collapsed"
                            BorderBrush="{DynamicResource Theme.AccentBrush}"
                            BorderThickness="2"
                            Background="{DynamicResource Theme.SelectionBrush}"
                            Opacity="0.65" />
                </Canvas>

                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="10"
                        Padding="3"
                        Background="{DynamicResource Theme.SurfaceBrush}"
                        BorderBrush="{DynamicResource Theme.BorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <Button Width="34"
                                Height="34"
                                Padding="0"
                                Click="ZoomIn_Click"
                                ToolTip="放大地图">
                            <iconPacks:PackIconLucide Kind="Plus" Width="18" Height="18" />
                        </Button>
                        <Button Width="34"
                                Height="34"
                                Margin="0,3,0,0"
                                Padding="0"
                                Click="ZoomOut_Click"
                                ToolTip="缩小地图">
                            <iconPacks:PackIconLucide Kind="Minus" Width="18" Height="18" />
                        </Button>
                    </StackPanel>
                </Border>

                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="8"
                        Padding="5,2"
                        Background="{DynamicResource Theme.SurfaceBrush}"
                        BorderBrush="{DynamicResource Theme.BorderBrush}"
                        BorderThickness="1">
                    <TextBlock FontSize="11">
                        <Hyperlink NavigateUri="https://www.openstreetmap.org/copyright"
                                   RequestNavigate="Attribution_RequestNavigate">© OpenStreetMap contributors</Hyperlink>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="12,10,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionStatusTextBlock"
                       VerticalAlignment="Center"
                       Text="尚未选择下载区域"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Theme.MutedTextBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <Button x:Name="DownloadButton"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="Download_Click"
                        Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Download" Width="17" Height="17" Margin="0,0,6,0" />
                        <TextBlock Text="下载" />
                    </StackPanel>
                </Button>
                <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" />
            </StackPanel>
            <ProgressBar x:Name="DownloadProgressBar"
                         Grid.Row="1"
                         Grid.ColumnSpan="2"
                         Height="3"
                         Margin="0,8,0,0"
                         IsIndeterminate="True"
                         Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
