<Window x:Class="WPF_OpenStreetmap_Editor.Views.OsmDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:WPF_OpenStreetmap_Editor.Controls"
        xmlns:services="clr-namespace:WPF_OpenStreetmap_Editor.Services"
        xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        Title="{services:Loc Osm.Download.Title}"
        Width="1000"
        Height="720"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBrush}"
        Foreground="{DynamicResource Theme.TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{services:Loc Osm.Download.StandardMap}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <Grid Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconLucide Grid.Column="0"
                                          Kind="Search"
                                          Width="16"
                                          Height="16"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource Theme.MutedTextBrush}" />
                <TextBox x:Name="SearchTextBox"
                         Grid.Column="1"
                         MinWidth="220"
                         Height="26"
                         VerticalContentAlignment="Center"
                         ToolTip="{services:Loc Osm.Download.SearchTooltip}"
                         TextChanged="SearchTextBox_TextChanged"
                         KeyDown="SearchTextBox_KeyDown" />
                <Button x:Name="SearchButton"
                        Grid.Column="2"
                        Width="26"
                        Height="26"
                        Margin="6,0,0,0"
                        Padding="0"
                        Click="Search_Click"
                        ToolTip="{services:Loc Osm.Download.SearchButton}">
                    <iconPacks:PackIconLucide Kind="Search" Width="14" Height="14" />
                </Button>
                <Button x:Name="ClearSearchButton"
                        Grid.Column="3"
                        Width="26"
                        Height="26"
                        Margin="4,0,0,0"
                        Padding="0"
                        IsEnabled="False"
                        Click="ClearSearch_Click"
                        ToolTip="{services:Loc Osm.Download.ClearSearch}">
                    <iconPacks:PackIconLucide Kind="X" Width="14" Height="14" />
                </Button>
            </Grid>

            <TextBlock x:Name="ZoomTextBlock"
                       Grid.Column="2"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Theme.MutedTextBrush}" />
        </Grid>

        <Border Grid.Row="1"
                Margin="12,0"
                BorderBrush="{DynamicResource Theme.BorderBrush}"
                BorderThickness="1">
            <Grid x:Name="MapViewport"
                  ClipToBounds="True"
                  Focusable="True"
                  Cursor="Cross"
                  Background="{DynamicResource Theme.MapBackgroundBrush}"
                  automation:AutomationProperties.Name="{services:Loc Osm.Download.MapAutomationName}"
                  MouseLeftButtonDown="MapViewport_MouseLeftButtonDown"
                  MouseLeftButtonUp="MapViewport_MouseLeftButtonUp"
                  MouseRightButtonDown="MapViewport_MouseRightButtonDown"
                  MouseRightButtonUp="MapViewport_MouseRightButtonUp"
                  MouseMove="MapViewport_MouseMove"
                  MouseWheel="MapViewport_MouseWheel"
                  SizeChanged="MapViewport_SizeChanged">
                <controls:TileLayerElement x:Name="TileLayer" IsHitTestVisible="False" />
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="SelectionRectangle"
                            Visibility="Collapsed"
                            BorderBrush="{DynamicResource Theme.AccentBrush}"
                            BorderThickness="2"
                            Background="{DynamicResource Theme.SelectionBrush}"
                            Opacity="0.65" />
                </Canvas>

                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="10"
                        Padding="3"
                        Background="{DynamicResource Theme.SurfaceBrush}"
                        BorderBrush="{DynamicResource Theme.BorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <Button Width="34"
                                Height="34"
                                Padding="0"
                                Click="ZoomIn_Click"
                                ToolTip="{services:Loc Osm.Download.ZoomIn}">
                            <iconPacks:PackIconLucide Kind="Plus" Width="18" Height="18" />
                        </Button>
                        <Button Width="34"
                                Height="34"
                                Margin="0,3,0,0"
                                Padding="0"
                                Click="ZoomOut_Click"
                                ToolTip="{services:Loc Osm.Download.ZoomOut}">
                            <iconPacks:PackIconLucide Kind="Minus" Width="18" Height="18" />
                        </Button>
                    </StackPanel>
                </Border>

                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="8"
                        Padding="5,2"
                        Background="{DynamicResource Theme.SurfaceBrush}"
                        BorderBrush="{DynamicResource Theme.BorderBrush}"
                        BorderThickness="1">
                    <TextBlock FontSize="11">
                        <Hyperlink NavigateUri="https://www.openstreetmap.org/copyright"
                                   RequestNavigate="Attribution_RequestNavigate">© OpenStreetMap contributors</Hyperlink>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="12,10,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionStatusTextBlock"
                       VerticalAlignment="Center"
                       Text="{services:Loc Osm.Download.NoSelection}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Theme.MutedTextBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <Button x:Name="DownloadButton"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="Download_Click"
                        Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Download" Width="17" Height="17" Margin="0,0,6,0" />
                        <TextBlock Text="{services:Loc Common.Download}" />
                    </StackPanel>
                </Button>
                <Button x:Name="CancelButton" Content="{services:Loc Common.Cancel}" Click="Cancel_Click" />
            </StackPanel>
            <ProgressBar x:Name="DownloadProgressBar"
                         Grid.Row="1"
                         Grid.ColumnSpan="2"
                         Height="3"
                         Margin="0,8,0,0"
                         IsIndeterminate="True"
                         Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
