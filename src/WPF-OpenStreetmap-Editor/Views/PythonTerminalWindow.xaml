<Window x:Class="WPF_OpenStreetmap_Editor.Views.PythonTerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="你好Python，你好世界" Height="420" Width="720"
        MinHeight="320" MinWidth="520"
        Background="{DynamicResource Theme.WindowBackgroundBrush}"
        Foreground="{DynamicResource Theme.TextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="IntroTextBlock"
                   Grid.Row="0"
                   Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   FontWeight="SemiBold" />

        <TextBox x:Name="OutputTextBox"
                 Grid.Row="1"
                 FontFamily="Consolas"
                 FontSize="13"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" />

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CommandTextBox"
                     Grid.Column="0"
                     MinHeight="30"
                     FontFamily="Consolas"
                     FontSize="13"
                     KeyDown="CommandTextBox_KeyDown" />
            <Button Grid.Column="1"
                    Width="88"
                    Margin="8,0,0,0"
                    Content="执行"
                    Click="Execute_Click" />
        </Grid>
    </Grid>
</Window>
