<Window x:Class="WPF_OpenStreetmap_Editor.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:WPF_OpenStreetmap_Editor.Services"
        Title="{services:Loc App.Title}"
        Width="760"
        Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Theme.WindowBackgroundBrush}"
        Foreground="{DynamicResource Theme.TextBrush}"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border x:Name="RootCard"
            Background="{DynamicResource Theme.WindowBackgroundBrush}"
            BorderBrush="{DynamicResource Theme.BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Margin="34,30,28,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Wosm"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Theme.TextBrush}" />
                    <TextBlock Text="{services:Loc App.Title}"
                               Margin="1,2,0,0"
                               FontSize="16"
                               Foreground="{DynamicResource Theme.TextBrush}" />
                    <TextBlock x:Name="VersionTextBlock"
                               Margin="1,14,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Theme.MutedTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitleTextBlock"
                               Text="{services:Loc Startup.Starting}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.TextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="StatusTextBlock"
                               Margin="0,8,0,0"
                               MinHeight="38"
                               FontSize="12"
                               LineHeight="18"
                               Foreground="{DynamicResource Theme.MutedTextBrush}"
                               Text="{services:Loc Startup.Preparing}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{services:Loc Startup.Progress}"
                               FontSize="11"
                               Foreground="{DynamicResource Theme.MutedTextBrush}" />
                    <TextBlock x:Name="PercentTextBlock"
                               HorizontalAlignment="Right"
                               FontSize="11"
                               Foreground="{DynamicResource Theme.MutedTextBrush}"
                               Text="0%" />
                    <ProgressBar x:Name="StartupProgressBar"
                                 Grid.Row="1"
                                 Height="4"
                                 Margin="0,9,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Background="{DynamicResource Theme.SurfaceAltBrush}"
                                 Foreground="{DynamicResource Theme.AccentBrush}"
                                 BorderThickness="0" />
                </Grid>
            </Grid>

            <Grid Grid.Column="1"
                  ClipToBounds="True">
                <Image Source="/WPF-OpenStreetmap-Editor;component/Assets/StartupMap.jpg"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Theme.ImageOverlayBrush}"
                        Padding="10,5">
                    <TextBlock Text="Source: Esri World Imagery"
                               FontSize="10"
                               Foreground="{DynamicResource Theme.ImageOverlayTextBrush}" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
