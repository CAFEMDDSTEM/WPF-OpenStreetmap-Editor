<Window x:Class="WPF_OpenStreetmap_Editor.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF OpenStreetmap Editor"
        Width="760"
        Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource SplashWindowBackgroundBrush}"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="SplashWindowBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SplashTextBrush" Color="#111111" />
        <SolidColorBrush x:Key="SplashMutedTextBrush" Color="#5E5E5E" />
        <SolidColorBrush x:Key="SplashBorderBrush" Color="#CFCFCF" />
        <SolidColorBrush x:Key="SplashProgressTrackBrush" Color="#E5E5E5" />
        <SolidColorBrush x:Key="SplashProgressBrush" Color="#111111" />
    </Window.Resources>

    <Border x:Name="RootCard"
            Background="{DynamicResource SplashWindowBackgroundBrush}"
            BorderBrush="{DynamicResource SplashBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Margin="34,30,28,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Wosm"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SplashTextBrush}" />
                    <TextBlock Text="OpenStreetMap Editor"
                               Margin="1,2,0,0"
                               FontSize="16"
                               Foreground="{DynamicResource SplashTextBrush}" />
                    <TextBlock x:Name="VersionTextBlock"
                               Margin="1,14,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource SplashMutedTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitleTextBlock"
                               Text="正在启动"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SplashTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="StatusTextBlock"
                               Margin="0,8,0,0"
                               MinHeight="38"
                               FontSize="12"
                               LineHeight="18"
                               Foreground="{DynamicResource SplashMutedTextBrush}"
                               Text="正在准备应用..."
                               TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="启动进度"
                               FontSize="11"
                               Foreground="{DynamicResource SplashMutedTextBrush}" />
                    <TextBlock x:Name="PercentTextBlock"
                               HorizontalAlignment="Right"
                               FontSize="11"
                               Foreground="{DynamicResource SplashMutedTextBrush}"
                               Text="0%" />
                    <ProgressBar x:Name="StartupProgressBar"
                                 Grid.Row="1"
                                 Height="4"
                                 Margin="0,9,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Background="{DynamicResource SplashProgressTrackBrush}"
                                 Foreground="{DynamicResource SplashProgressBrush}"
                                 BorderThickness="0" />
                </Grid>
            </Grid>

            <Grid Grid.Column="1"
                  ClipToBounds="True">
                <Image Source="/WPF-OpenStreetmap-Editor;component/Assets/StartupMap.jpg"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="#A0000000"
                        Padding="10,5">
                    <TextBlock Text="Source: Esri World Imagery"
                               FontSize="10"
                               Foreground="White" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
