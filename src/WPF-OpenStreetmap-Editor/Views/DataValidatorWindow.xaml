<Window x:Class="WPF_OpenStreetmap_Editor.Views.DataValidatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:WPF_OpenStreetmap_Editor.Services"
        xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        Title="{services:Loc DataValidator.Title}"
        Height="640"
        Width="560"
        MinHeight="520"
        MinWidth="500"
        Background="{DynamicResource Theme.WindowBackgroundBrush}"
        Foreground="{DynamicResource Theme.TextBrush}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="ValidatorCheckBoxStyle" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="10,8,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <TextBlock Text="{services:Loc DataValidator.Title}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,2" />
                <TextBlock Text="{services:Loc DataValidator.Description}"
                           FontStyle="Italic"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Theme.TextBrush}" />
            </StackPanel>
            <iconPacks:PackIconLucide Grid.Column="1"
                                      Kind="Check"
                                      Width="56"
                                      Height="56"
                                      Margin="12,0,2,0"
                                      VerticalAlignment="Top"
                                      Foreground="{DynamicResource Theme.AccentBrush}" />
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="{services:Loc DataValidator.TestTab}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,2">
                        <CheckBox Content="{services:Loc DataValidator.UseIgnoreList}"
                                  IsChecked="True"
                                  Style="{StaticResource ValidatorCheckBoxStyle}" />
                        <CheckBox Content="{services:Loc DataValidator.UseErrorLayer}"
                                  IsChecked="True"
                                  Style="{StaticResource ValidatorCheckBoxStyle}" />
                        <CheckBox Content="{services:Loc DataValidator.ShowInformationLevel}"
                                  Style="{StaticResource ValidatorCheckBoxStyle}" />
                        <CheckBox Content="{services:Loc DataValidator.ShowInformationLevelOnUpload}"
                                  IsEnabled="False"
                                  Style="{StaticResource ValidatorCheckBoxStyle}" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,18,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="74" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{services:Loc DataValidator.RunWhenEditing}"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1"
                                       Text="{services:Loc DataValidator.RunWhenUploading}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Rules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="{Binding Indent}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="74" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0"
                                                      Content="{Binding Name}"
                                                      IsChecked="{Binding RunWhenEditing}"
                                                      Style="{StaticResource ValidatorCheckBoxStyle}" />
                                            <CheckBox Grid.Column="1"
                                                      IsChecked="{Binding RunWhenUploading}"
                                                      IsEnabled="{Binding HasUploadOption}"
                                                      AutomationProperties.Name="{Binding UploadOptionName}"
                                                      ToolTip="{Binding UploadOptionName}"
                                                      HorizontalAlignment="Right"
                                                      Style="{StaticResource ValidatorCheckBoxStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{services:Loc DataValidator.TagCheckerRulesTab}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{services:Loc DataValidator.TagCheckerRulesTab}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBox Grid.Row="1"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             Padding="8"
                             Text="{services:Loc DataValidator.TagCheckerRulesPlaceholder}" />
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="{services:Loc Common.Close}"
                    Width="88"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
