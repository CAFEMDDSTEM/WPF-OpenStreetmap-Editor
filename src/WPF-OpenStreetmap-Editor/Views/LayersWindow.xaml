<Window x:Class="WPF_OpenStreetmap_Editor.Views.LayersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图层管理" Height="420" Width="480"
        Background="{DynamicResource Theme.WindowBackgroundBrush}"
        Foreground="{DynamicResource Theme.TextBrush}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,6">
            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0">图层 URL:</TextBlock>
            <TextBox x:Name="LayerUrlTextBox" Width="320" />
            <ComboBox x:Name="LayerTypeComboBox" Width="80" Margin="6,0,0,0" SelectedIndex="0">
                <ComboBoxItem>XYZ</ComboBoxItem>
                <ComboBoxItem>TMS</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <ListBox x:Name="LayersListBox" Grid.Row="1" />

        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="添加" Width="80" Click="AddLayer_Click" Margin="0,0,6,0" />
            <Button Content="删除选中" Width="80" Click="RemoveLayer_Click" Margin="0,0,6,0" />
            <Button Content="加载选中" Width="100" Click="LoadSelected_Click" />
        </StackPanel>
    </Grid>
</Window>
