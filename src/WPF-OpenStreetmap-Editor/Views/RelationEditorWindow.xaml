<Window x:Class="WPF_OpenStreetmap_Editor.Views.RelationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:WPF_OpenStreetmap_Editor.Services"
        Title="{services:Loc Osm.Relation.Title}"
        Height="560"
        Width="760"
        MinHeight="420"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBrush}"
        Foreground="{DynamicResource Theme.TextBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="HeaderTextBlock" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="MemberCountTextBlock"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource Theme.MutedTextBrush}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="270" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid x:Name="MembersDataGrid"
                          Grid.Row="0"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{services:Loc Common.Type}" Binding="{Binding TypeName}" IsReadOnly="True" Width="70" />
                        <DataGridTextColumn Header="{services:Loc Main.Features.Id}" Binding="{Binding Id}" IsReadOnly="True" Width="90" />
                        <DataGridTextColumn Header="{services:Loc Osm.Relation.Role}" Binding="{Binding Role}" Width="80" />
                        <DataGridTextColumn Header="{services:Loc Osm.Relation.Info}" Binding="{Binding Description}" IsReadOnly="True" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="{services:Loc Common.Remove}" Click="RemoveMember_Click" Margin="0,0,6,0" />
                    <Button Content="{services:Loc Osm.Relation.MoveUp}" Click="MoveUp_Click" Margin="0,0,6,0" />
                    <Button Content="{services:Loc Osm.Relation.MoveDown}" Click="MoveDown_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource Theme.BorderBrush}"
                    BorderThickness="1"
                    Padding="10"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{services:Loc Osm.Relation.CandidateType}" Margin="0,0,0,4" />
                    <ComboBox x:Name="TypeComboBox"
                              Grid.Row="1"
                              Margin="0,0,0,8"
                              SelectionChanged="TypeComboBox_SelectionChanged" />
                    <TextBlock Grid.Row="2"
                               Text="{services:Loc Osm.Relation.Candidates}"
                               Margin="0,0,0,4" />
                    <ListBox x:Name="CandidateListBox"
                             Grid.Row="2"
                             Margin="0,22,0,8"
                             DisplayMemberPath="Display"
                             SelectionMode="Single" />
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{services:Loc Osm.Relation.Role}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBox x:Name="RoleTextBox" Grid.Column="1" />
                    </Grid>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="{services:Loc Osm.Relation.AddMember}" Click="AddMember_Click" Margin="0,0,6,0" />
                        <Button x:Name="AddSelectedButton"
                                Content="{services:Loc Osm.Relation.AddSelected}"
                                Click="AddSelected_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="{services:Loc Common.Save}"
                    IsDefault="True"
                    Click="Save_Click"
                    Margin="0,0,6,0" />
            <Button Content="{services:Loc Common.Cancel}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
