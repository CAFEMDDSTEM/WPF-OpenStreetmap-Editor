<Window x:Class="WPF_OpenStreetmap_Editor.Views.FeatureTagsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:WPF_OpenStreetmap_Editor.Services"
        Title="{services:Loc FeatureTags.Title}"
        Height="420"
        Width="560"
        MinHeight="320"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBrush}"
        Foreground="{DynamicResource Theme.TextBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="FeatureTextBlock"
                   Grid.Row="0"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <TextBox x:Name="TagsTextBox"
                 Grid.Row="1"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="{services:Loc Common.Save}"
                    IsDefault="True"
                    Click="Save_Click"
                    Margin="0,0,6,0" />
            <Button Content="{services:Loc Common.Cancel}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
