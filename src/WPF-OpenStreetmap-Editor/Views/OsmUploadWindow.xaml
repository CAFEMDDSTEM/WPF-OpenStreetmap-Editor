<Window x:Class="WPF_OpenStreetmap_Editor.Views.OsmUploadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upload to OpenStreetMap"
        Height="560"
        Width="860"
        MinHeight="460"
        MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBrush}"
        Foreground="{DynamicResource Theme.TextBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <GroupBox x:Name="CreateGroupBox" Grid.Row="0" Header="Create" Margin="0,0,0,6">
                    <ListBox x:Name="CreateListBox" DisplayMemberPath="Label" SelectionChanged="ChangeList_SelectionChanged" />
                </GroupBox>
                <GroupBox x:Name="ModifyGroupBox" Grid.Row="1" Header="Modify" Margin="0,0,0,6">
                    <ListBox x:Name="ModifyListBox" DisplayMemberPath="Label" SelectionChanged="ChangeList_SelectionChanged" />
                </GroupBox>
                <GroupBox x:Name="DeleteGroupBox" Grid.Row="2" Header="Delete">
                    <ListBox x:Name="DeleteListBox" DisplayMemberPath="Label" SelectionChanged="ChangeList_SelectionChanged" />
                </GroupBox>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="AccountTextBlock" Grid.Row="0" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock x:Name="ChangeSummaryTextBlock" Grid.Row="1" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />

                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="Changeset comment" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CommentComboBox"
                                  Grid.Column="0"
                                  IsEditable="True"
                                  MaxDropDownHeight="160" />
                        <Button x:Name="AiSummaryButton"
                                Grid.Column="1"
                                Content="AI 生成"
                                Padding="10,1"
                                Margin="8,0,0,0"
                                Click="AiSummary_Click" />
                    </Grid>
                </StackPanel>

                <CheckBox x:Name="ReviewRequestedCheckBox"
                          Grid.Row="3"
                          Content="Request review from other mappers"
                          Margin="0,0,0,10" />

                <StackPanel Grid.Row="4">
                    <TextBlock Text="Source" Margin="0,0,0,4" />
                    <ComboBox x:Name="SourceComboBox" IsEditable="True" MaxDropDownHeight="160" />
                    <TextBlock x:Name="SettingsTextBlock"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.MutedTextBrush}"
                               Margin="0,12,0,0" />
                </StackPanel>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Row="5"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Theme.MutedTextBrush}"
                           Margin="0,10,0,0" />
            </Grid>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="EditMetadataButton" Content="Edit Raw ID" Click="EditMetadata_Click" Margin="0,0,8,0" />
            <Button Content="Upload Changes" IsDefault="True" Click="Upload_Click" Margin="0,0,8,0" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
