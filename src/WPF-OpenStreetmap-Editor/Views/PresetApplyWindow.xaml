<Window x:Class="WPF_OpenStreetmap_Editor.Views.PresetApplyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:WPF_OpenStreetmap_Editor.Services"
        Title="{services:Loc PresetFields.Title}"
        Height="620"
        Width="520"
        MinHeight="380"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBrush}"
        Foreground="{DynamicResource Theme.TextBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="PresetNameTextBlock"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Text="{services:Loc PresetFields.Description}"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource Theme.MutedTextBrush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="FixedTagsTextBlock"
                       Margin="0,8,0,0"
                       FontFamily="Consolas"
                       Foreground="{DynamicResource Theme.MutedTextBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="FieldsPanel" />
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="{services:Loc PresetFields.Apply}"
                    IsDefault="True"
                    Click="Apply_Click"
                    Margin="0,0,6,0" />
            <Button Content="{services:Loc Common.Cancel}"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
