<Window x:Class="WPF_OpenStreetmap_Editor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="660" Width="860"
        MinHeight="560" MinWidth="740"
        Background="{DynamicResource Theme.WindowBackgroundBrush}"
        Foreground="{DynamicResource Theme.TextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="SettingsTabControl" Grid.Row="0">
            <TabItem x:Name="AppearanceTabItem" Header="外观">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.ColumnSpan="2"
                               Text="主题"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="界面主题"
                               VerticalAlignment="Center"
                               Margin="0,0,8,10" />
                    <ComboBox x:Name="ThemeComboBox"
                              Grid.Row="1"
                              Grid.Column="1"
                              Width="390"
                              HorizontalAlignment="Left"
                              SelectionChanged="ThemeComboBox_SelectionChanged"
                              Margin="0,0,0,10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="350" Margin="1,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="30"
                                           Height="30"
                                           Source="{Binding Icon}"
                                           Stretch="Uniform"
                                           VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Author, StringFormat=作者：{0}}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Theme.MutedTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Grid.Row="2"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="0,0,0,12">
                        <Button x:Name="ImportThemeButton"
                                Content="导入主题..."
                                Click="ImportTheme_Click"
                                Margin="0,0,8,0" />
                        <Button x:Name="RemoveThemeButton"
                                Content="删除主题"
                                Click="RemoveTheme_Click"
                                IsEnabled="False" />
                    </StackPanel>
                    <TextBlock x:Name="ThemeMetadataTextBlock"
                               Grid.Row="3"
                               Grid.Column="1"
                               Foreground="{DynamicResource Theme.MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <TextBlock x:Name="ThemeErrorsTextBlock"
                               Grid.Row="5"
                               Grid.Column="1"
                               Foreground="{DynamicResource Theme.MutedTextBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                    <ScrollViewer Grid.Row="4"
                                  Grid.Column="1"
                                  MaxHeight="84"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="0,0,0,8">
                        <TextBlock x:Name="ThemeDescriptionTextBlock"
                                   Foreground="{DynamicResource Theme.TextBrush}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                    <Border Grid.Row="6"
                            Grid.ColumnSpan="2"
                            Margin="0,14,0,0"
                            Padding="16"
                            Background="{DynamicResource Theme.WindowBackgroundBrush}"
                            BorderBrush="{DynamicResource Theme.BorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="WOSM"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="OpenStreetMap Editor"
                                       Foreground="{DynamicResource Theme.MutedTextBrush}"
                                       Margin="0,3,0,14" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="主要操作"
                                        Background="{DynamicResource Theme.AccentBrush}"
                                        Foreground="{DynamicResource Theme.AccentTextBrush}"
                                        BorderBrush="{DynamicResource Theme.AccentBrush}"
                                        Margin="0,0,8,0" />
                                <Button Content="普通操作" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="SourcesTabItem" Header="图源">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="图源" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ListBox x:Name="SourcesListBox"
                                 Grid.Row="1"
                                 DisplayMemberPath="Name"
                                 SelectionChanged="SourcesListBox_SelectionChanged" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="添加" Width="72" Margin="0,0,6,0" Click="AddSource_Click" />
                            <Button Content="删除" Width="72" Click="RemoveSource_Click" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="名称" Margin="0,0,8,8" />
                            <TextBox x:Name="SourceNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Text="URL" Margin="0,3,8,8" />
                            <TextBox x:Name="SourceUrlTextBox"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Height="72"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,8" />

                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="地图最大层级" Margin="0,0,8,8" />
                            <TextBox x:Name="MapMaxZoomTextBox" Grid.Row="2" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="影像最大层级" Margin="0,0,8,8" />
                            <TextBox x:Name="ImageMaxZoomTextBox" Grid.Row="3" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="API key / Token" Margin="0,0,8,8" />
                            <PasswordBox x:Name="AccessTokenPasswordBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Text="署名文本" Margin="0,0,8,8" />
                            <TextBox x:Name="AttributionTextBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="署名链接" Margin="0,0,8,8" />
                            <TextBox x:Name="AttributionUrlTextBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Top" Text="No-tile ETag" Margin="0,3,8,8" />
                            <TextBox x:Name="NoTileEtagsTextBox"
                                     Grid.Row="7"
                                     Grid.Column="1"
                                     Height="70"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,8" />

                            <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Top" Text="No-tile MD5" Margin="0,3,8,8" />
                            <TextBox x:Name="NoTileMd5sTextBox"
                                     Grid.Row="8"
                                     Grid.Column="1"
                                     Height="70"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,8" />

                            <CheckBox x:Name="VisibleCheckBox"
                                      Grid.Row="9"
                                      Grid.Column="1"
                                      Content="添加图层时默认显示"
                                      Margin="0,0,0,8" />

                            <CheckBox x:Name="KnownSourceCheckBox"
                                      Grid.Row="10"
                                      Grid.Column="1"
                                      Content="已知图源，不自动探测最大影像层级"
                                      Margin="0,0,0,8" />

                            <CheckBox x:Name="ExperimentalSmoothZoomCheckBox"
                                      Grid.Row="11"
                                      Grid.Column="1"
                                      Content="实验性功能：无极缩放"
                                      Margin="0,8,0,8" />

                            <TextBlock Grid.Row="12"
                                       Grid.Column="1"
                                       Foreground="{DynamicResource Theme.MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="URL 支持 xyz[19]:、tms[18]:、tms[auto]: 和 tms: 前缀。已知图源使用这里配置的影像最大层级；自定义 tms[auto]/tms: 图源会自动探测。" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="取消" Width="88" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="保存" Width="88" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
