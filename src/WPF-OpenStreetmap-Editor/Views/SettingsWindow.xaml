<Window x:Class="WPF_OpenStreetmap_Editor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        xmlns:services="clr-namespace:WPF_OpenStreetmap_Editor.Services"
        Title="{services:Loc Settings.Title}" Height="660" Width="860"
        MinHeight="560" MinWidth="740"
        Background="{DynamicResource Theme.WindowBackgroundBrush}"
        Foreground="{DynamicResource Theme.TextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="SettingsTabControl" Grid.Row="0">
            <TabItem x:Name="AppearanceTabItem" Header="{services:Loc Settings.Appearance}">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.ColumnSpan="2"
                               Text="{services:Loc Settings.Theme}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="{services:Loc Settings.InterfaceTheme}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,10" />
                    <ComboBox x:Name="ThemeComboBox"
                              Grid.Row="1"
                              Grid.Column="1"
                              Width="390"
                              HorizontalAlignment="Left"
                              SelectionChanged="ThemeComboBox_SelectionChanged"
                              Margin="0,0,0,10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="350" Margin="1,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="30"
                                           Height="30"
                                           Source="{Binding Icon}"
                                           Stretch="Uniform"
                                           VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource Theme.MutedTextBrush}">
                                            <Run Text="{services:Loc Settings.AuthorLabel}" />
                                            <Run Text="{Binding Author}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Grid.Row="2"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="0,0,0,12">
                        <Button x:Name="ImportThemeButton"
                                Content="{services:Loc Settings.ImportTheme}"
                                Click="ImportTheme_Click"
                                Margin="0,0,8,0" />
                        <Button x:Name="RemoveThemeButton"
                                Content="{services:Loc Settings.RemoveTheme}"
                                Click="RemoveTheme_Click"
                                IsEnabled="False" />
                    </StackPanel>
                    <TextBlock x:Name="ThemeMetadataTextBlock"
                               Grid.Row="3"
                               Grid.Column="1"
                               Foreground="{DynamicResource Theme.MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <TextBlock x:Name="ThemeErrorsTextBlock"
                               Grid.Row="6"
                               Grid.Column="1"
                               Foreground="{DynamicResource Theme.MutedTextBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                    <ScrollViewer Grid.Row="4"
                                  Grid.Column="1"
                                  MaxHeight="84"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="0,0,0,8">
                        <TextBlock x:Name="ThemeDescriptionTextBlock"
                                   Foreground="{DynamicResource Theme.TextBrush}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                    <TextBlock Grid.Row="5"
                               Grid.Column="0"
                               Text="{services:Loc Settings.InterfaceLanguage}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,12" />
                    <ComboBox x:Name="LanguageComboBox"
                              Grid.Row="5"
                              Grid.Column="1"
                              Width="390"
                              HorizontalAlignment="Left"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Id"
                              SelectionChanged="LanguageComboBox_SelectionChanged"
                              Margin="0,0,0,12" />
                    <Border Grid.Row="7"
                            Grid.ColumnSpan="2"
                            Margin="0,14,0,0"
                            Padding="16"
                            Background="{DynamicResource Theme.WindowBackgroundBrush}"
                            BorderBrush="{DynamicResource Theme.BorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="WOSM"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="OpenStreetMap Editor"
                                       Foreground="{DynamicResource Theme.MutedTextBrush}"
                                       Margin="0,3,0,14" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{services:Loc Settings.PreviewPrimaryAction}"
                                        Background="{DynamicResource Theme.AccentBrush}"
                                        Foreground="{DynamicResource Theme.AccentTextBrush}"
                                        BorderBrush="{DynamicResource Theme.AccentBrush}"
                                        Margin="0,0,8,0" />
                                <Button Content="{services:Loc Settings.PreviewSecondaryAction}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="DataTabItem" Header="{services:Loc Settings.Data}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.ColumnSpan="2"
                               Text="{services:Loc Settings.ImportProjection}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="{services:Loc Settings.DefaultImportProjection}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,10" />
                    <ComboBox x:Name="ImportProjectionComboBox"
                              Grid.Row="1"
                              Grid.Column="1"
                              Width="390"
                              HorizontalAlignment="Left"
                              DisplayMemberPath="Name"
                              SelectionChanged="ImportProjectionComboBox_SelectionChanged"
                              Margin="0,0,0,10" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="{services:Loc Settings.CustomProjectionWkt}"
                               VerticalAlignment="Top"
                               Margin="0,3,8,10" />
                    <TextBox x:Name="CustomProjectionWktTextBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Height="160"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,10" />
                    <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               Foreground="{DynamicResource Theme.MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"
                               Text="{services:Loc Settings.ImportProjectionHelp}" />

                    <TextBlock Grid.Row="4"
                               Grid.ColumnSpan="2"
                               Text="{services:Loc Settings.DisplayAlignment}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14" />
                    <TextBlock Grid.Row="5"
                               Grid.Column="0"
                               Text="{services:Loc Settings.DisplayAlignmentProjection}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,10" />
                    <ComboBox x:Name="DisplayAlignmentProjectionComboBox"
                              Grid.Row="5"
                              Grid.Column="1"
                              Width="390"
                              HorizontalAlignment="Left"
                              DisplayMemberPath="Name"
                              SelectionChanged="DisplayAlignmentProjectionComboBox_SelectionChanged"
                              Margin="0,0,0,10" />
                    <TextBlock Grid.Row="6"
                               Grid.Column="0"
                               Text="{services:Loc Settings.DisplayAlignmentOffset}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,10" />
                    <StackPanel Grid.Row="6"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="0,0,0,10">
                        <TextBox x:Name="DisplayAlignmentOffsetXTextBox"
                                 Width="110"
                                 Margin="0,0,8,0" />
                        <TextBox x:Name="DisplayAlignmentOffsetYTextBox"
                                 Width="110" />
                    </StackPanel>
                    <TextBlock Grid.Row="7"
                               Grid.Column="0"
                               Text="{services:Loc Settings.CustomProjectionWkt}"
                               VerticalAlignment="Top"
                               Margin="0,3,8,10" />
                    <TextBox x:Name="CustomDisplayAlignmentProjectionWktTextBox"
                             Grid.Row="7"
                             Grid.Column="1"
                             Height="110"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,10" />
                    <TextBlock Grid.Row="8"
                               Grid.Column="1"
                               Foreground="{DynamicResource Theme.MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"
                               Text="{services:Loc Settings.DisplayAlignmentHelp}" />

                    <TextBlock Grid.Row="9"
                               Grid.ColumnSpan="2"
                               Text="{services:Loc Settings.TileStoragePerformance}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14" />
                    <TextBlock Grid.Row="10"
                               Grid.Column="0"
                               Text="{services:Loc Settings.TilePerformanceMode}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,10" />
                    <ComboBox x:Name="TilePerformanceModeComboBox"
                              Grid.Row="10"
                              Grid.Column="1"
                              Width="390"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,10">
                        <ComboBoxItem Tag="Responsive"
                                      Content="{services:Loc Settings.TilePerformanceResponsive}" />
                        <ComboBoxItem Tag="MemorySaver"
                                      Content="{services:Loc Settings.TilePerformanceMemorySaver}" />
                    </ComboBox>
                    <TextBlock Grid.Row="11"
                               Grid.Column="0"
                               Text="{services:Loc Settings.TileCacheDays}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,10" />
                    <TextBox x:Name="TileCacheDaysTextBox"
                             Grid.Row="11"
                             Grid.Column="1"
                             Width="80"
                             HorizontalAlignment="Left"
                             Margin="0,0,0,10" />
                    <TextBlock Grid.Row="12"
                               Grid.Column="1"
                               Foreground="{DynamicResource Theme.MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="{services:Loc Settings.TileStorageHelp}"
                               Margin="0,0,0,18" />

                    <TextBlock Grid.Row="13"
                               Grid.ColumnSpan="2"
                               Text="{services:Loc Settings.FileBackup}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14" />
                    <CheckBox x:Name="AutosaveEnabledCheckBox"
                              Grid.Row="14"
                              Grid.Column="1"
                              Content="{services:Loc Settings.EnableAutosave}"
                              Margin="0,0,0,10" />
                    <TextBlock Grid.Row="15"
                               Grid.Column="0"
                               Text="{services:Loc Settings.AutosaveIntervalSeconds}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,10" />
                    <TextBox x:Name="AutosaveIntervalSecondsTextBox"
                             Grid.Row="15"
                             Grid.Column="1"
                             Width="80"
                             HorizontalAlignment="Left"
                             Margin="0,0,0,10" />
                    <TextBlock Grid.Row="16"
                               Grid.Column="0"
                               Text="{services:Loc Settings.AutosaveFilesPerLayer}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,10" />
                    <TextBox x:Name="AutosaveFilesPerLayerTextBox"
                             Grid.Row="16"
                             Grid.Column="1"
                             Width="80"
                             HorizontalAlignment="Left"
                             Margin="0,0,0,10" />
                    <TextBlock Grid.Row="17"
                               Grid.Column="1"
                               Foreground="{DynamicResource Theme.MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="{services:Loc Settings.AutosaveHelp}"
                               Margin="0,0,0,14" />
                    <Separator Grid.Row="18"
                               Grid.ColumnSpan="2"
                               Margin="0,0,0,12" />
                    <CheckBox x:Name="KeepBackupFileOnSaveCheckBox"
                              Grid.Row="19"
                              Grid.Column="1"
                              Content="{services:Loc Settings.KeepBackupFileOnSave}"
                              Margin="0,0,0,10" />
                    <TextBlock Grid.Row="20"
                               Grid.Column="1"
                               Foreground="{DynamicResource Theme.MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="{services:Loc Settings.KeepBackupHelp}"
                               Margin="0,0,0,14" />
                    <Separator Grid.Row="21"
                               Grid.ColumnSpan="2"
                               Margin="0,0,0,12" />
                    <CheckBox x:Name="NotifyOnEverySaveCheckBox"
                              Grid.Row="22"
                              Grid.Column="1"
                              Content="{services:Loc Settings.NotifyOnEverySave}"
                              Margin="0,0,0,6" />
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="GpsTabItem" Header="{services:Loc Settings.GpsPoints}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="22,18,22,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,72,24">
                            <TextBlock Text="{services:Loc Settings.GpsPoints}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{services:Loc Settings.GpsPointsDescription}"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource Theme.MutedTextBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <iconPacks:PackIconLucide Grid.Row="0"
                                                  Grid.ColumnSpan="2"
                                                  Kind="MapPin"
                                                  Width="48"
                                                  Height="48"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Top"
                                                  Foreground="{DynamicResource Theme.AccentBrush}" />

                        <CheckBox x:Name="GpsDrawLinesBetweenPointsCheckBox"
                                  Grid.Row="1"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="2"
                                  Content="{services:Loc Settings.GpsDrawLinesBetweenPoints}"
                                  Margin="4,0,0,8" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="{services:Loc Settings.GpsLineMinimumDistancePixels}"
                                   VerticalAlignment="Center"
                                   Margin="16,0,10,8" />
                        <TextBox x:Name="GpsLineMinimumDistanceTextBox"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Width="310"
                                 HorizontalAlignment="Left"
                                 Margin="0,0,0,8" />
                        <CheckBox x:Name="GpsDrawLargePointsCheckBox"
                                  Grid.Row="3"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="2"
                                  Content="{services:Loc Settings.GpsDrawLargePoints}"
                                  Margin="4,0,0,8" />
                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Text="{services:Loc Settings.GpxTrackDrawingWidth}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,22" />
                        <TextBox x:Name="GpsTrackDrawingWidthTextBox"
                                 Grid.Row="4"
                                 Grid.Column="1"
                                 Width="310"
                                 HorizontalAlignment="Left"
                                 Margin="0,0,0,22" />

                        <TextBlock Grid.Row="5"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Text="{services:Loc Settings.GpsTrackPointColors}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <RadioButton x:Name="GpsSingleColorRadioButton"
                                     Grid.Row="6"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     GroupName="GpsTrackColorMode"
                                     Content="{services:Loc Settings.GpsColorSingle}"
                                     Checked="GpsTrackColorModeRadioButton_Checked"
                                     Margin="26,0,0,8" />
                        <StackPanel Grid.Row="7"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Margin="26,0,0,8">
                            <RadioButton x:Name="GpsSpeedColorRadioButton"
                                         GroupName="GpsTrackColorMode"
                                         Content="{services:Loc Settings.GpsColorSpeed}"
                                         Checked="GpsTrackColorModeRadioButton_Checked"
                                         VerticalAlignment="Center" />
                            <ComboBox x:Name="GpsSpeedProfileComboBox"
                                      Width="310"
                                      Margin="16,0,0,0">
                                <ComboBoxItem Tag="Car" Content="{services:Loc Settings.GpsSpeedProfileCar}" />
                                <ComboBoxItem Tag="Bicycle" Content="{services:Loc Settings.GpsSpeedProfileBicycle}" />
                                <ComboBoxItem Tag="Walk" Content="{services:Loc Settings.GpsSpeedProfileWalk}" />
                            </ComboBox>
                        </StackPanel>
                        <RadioButton x:Name="GpsFixedValueColorRadioButton"
                                     Grid.Row="8"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     GroupName="GpsTrackColorMode"
                                     Content="{services:Loc Settings.GpsColorFixedValue}"
                                     Checked="GpsTrackColorModeRadioButton_Checked"
                                     Margin="26,0,0,8" />
                        <RadioButton x:Name="GpsReferenceIdColorRadioButton"
                                     Grid.Row="9"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     GroupName="GpsTrackColorMode"
                                     Content="{services:Loc Settings.GpsColorReferenceId}"
                                     Checked="GpsTrackColorModeRadioButton_Checked"
                                     Margin="26,0,0,8" />
                        <RadioButton x:Name="GpsTimestampColorRadioButton"
                                     Grid.Row="10"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     GroupName="GpsTrackColorMode"
                                     Content="{services:Loc Settings.GpsColorTimestamp}"
                                     Checked="GpsTrackColorModeRadioButton_Checked"
                                     Margin="26,0,0,8" />

                        <StackPanel Grid.Row="11"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Margin="26,0,0,10">
                            <RadioButton x:Name="GpsHeatmapColorRadioButton"
                                         GroupName="GpsTrackColorMode"
                                         Content="{services:Loc Settings.GpsColorHeatmap}"
                                         Checked="GpsTrackColorModeRadioButton_Checked"
                                         VerticalAlignment="Center" />
                            <Border Width="22"
                                    Height="22"
                                    Background="{DynamicResource Theme.GpsHeatmapBrush}"
                                    BorderBrush="{DynamicResource Theme.BorderBrush}"
                                    BorderThickness="1"
                                    Margin="16,0,8,0" />
                            <ComboBox x:Name="GpsHeatmapBlendModeComboBox"
                                      Width="280">
                                <ComboBoxItem Tag="Normal" Content="{services:Loc Settings.GpsHeatmapBlendNormal}" />
                                <ComboBoxItem Tag="Additive" Content="{services:Loc Settings.GpsHeatmapBlendAdditive}" />
                                <ComboBoxItem Tag="Multiply" Content="{services:Loc Settings.GpsHeatmapBlendMultiply}" />
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Grid.Row="12"
                                   Grid.Column="0"
                                   Text="{services:Loc Settings.GpsHeatmapOverlayAdjustment}"
                                   Foreground="{DynamicResource Theme.MutedTextBrush}"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,6" />
                        <Grid Grid.Row="12" Grid.Column="1" Width="310" HorizontalAlignment="Left" Margin="0,0,0,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Slider x:Name="GpsHeatmapOverlayAdjustmentSlider"
                                    Grid.Row="0"
                                    Minimum="-10"
                                    Maximum="10"
                                    TickFrequency="5" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="-10" FontSize="11" Foreground="{DynamicResource Theme.MutedTextBrush}" />
                                <TextBlock Grid.Column="1" Text="-5" FontSize="11" Foreground="{DynamicResource Theme.MutedTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="0" FontSize="11" Foreground="{DynamicResource Theme.MutedTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="5" FontSize="11" Foreground="{DynamicResource Theme.MutedTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="10" FontSize="11" Foreground="{DynamicResource Theme.MutedTextBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </Grid>

                        <CheckBox x:Name="GpsHeatmapUseTargetColorCheckBox"
                                  Grid.Row="13"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="2"
                                  Content="{services:Loc Settings.GpsHeatmapUseTargetColor}"
                                  Margin="40,0,0,0" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="SourcesTabItem" Header="{services:Loc Settings.Sources}">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{services:Loc Settings.Sources}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ListBox x:Name="SourcesListBox"
                                 Grid.Row="1"
                                 DisplayMemberPath="Name"
                                 SelectionChanged="SourcesListBox_SelectionChanged" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="{services:Loc Common.Add}" Width="72" Margin="0,0,6,0" Click="AddSource_Click" />
                            <Button Content="{services:Loc Common.Delete}" Width="72" Click="RemoveSource_Click" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{services:Loc Settings.SourceName}" Margin="0,0,8,8" />
                            <TextBox x:Name="SourceNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Text="{services:Loc Settings.SourceUrl}" Margin="0,3,8,8" />
                            <TextBox x:Name="SourceUrlTextBox"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Height="72"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,8" />

                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{services:Loc Settings.MapMaxZoom}" Margin="0,0,8,8" />
                            <TextBox x:Name="MapMaxZoomTextBox" Grid.Row="2" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="{services:Loc Settings.ImageMaxZoom}" Margin="0,0,8,8" />
                            <TextBox x:Name="ImageMaxZoomTextBox" Grid.Row="3" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{services:Loc Settings.ApiKeyToken}" Margin="0,0,8,8" />
                            <PasswordBox x:Name="AccessTokenPasswordBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Text="{services:Loc Settings.AttributionText}" Margin="0,0,8,8" />
                            <TextBox x:Name="AttributionTextBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="{services:Loc Settings.AttributionUrl}" Margin="0,0,8,8" />
                            <TextBox x:Name="AttributionUrlTextBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Top" Text="{services:Loc Settings.NoTileEtag}" Margin="0,3,8,8" />
                            <TextBox x:Name="NoTileEtagsTextBox"
                                     Grid.Row="7"
                                     Grid.Column="1"
                                     Height="70"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,8" />

                            <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Top" Text="{services:Loc Settings.NoTileMd5}" Margin="0,3,8,8" />
                            <TextBox x:Name="NoTileMd5sTextBox"
                                     Grid.Row="8"
                                     Grid.Column="1"
                                     Height="70"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,8" />

                            <CheckBox x:Name="VisibleCheckBox"
                                      Grid.Row="9"
                                      Grid.Column="1"
                                      Content="{services:Loc Settings.VisibleByDefault}"
                                      Margin="0,0,0,8" />

                            <CheckBox x:Name="KnownSourceCheckBox"
                                      Grid.Row="10"
                                      Grid.Column="1"
                                      Content="{services:Loc Settings.KnownSource}"
                                      Margin="0,0,0,8" />

                            <CheckBox x:Name="ExperimentalSmoothZoomCheckBox"
                                      Grid.Row="11"
                                      Grid.Column="1"
                                      Content="{services:Loc Settings.ExperimentalSmoothZoom}"
                                      Margin="0,8,0,8" />

                            <TextBlock Grid.Row="12"
                                       Grid.Column="1"
                                       Foreground="{DynamicResource Theme.MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="{services:Loc Settings.UrlHelp}" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{services:Loc Common.Cancel}" Width="88" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="{services:Loc Common.Save}" Width="88" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
