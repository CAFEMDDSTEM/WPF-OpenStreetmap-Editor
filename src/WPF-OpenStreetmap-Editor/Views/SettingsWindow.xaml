<Window x:Class="WPF_OpenStreetmap_Editor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:WPF_OpenStreetmap_Editor.Services"
        Title="{services:Loc Settings.Title}" Height="660" Width="860"
        MinHeight="560" MinWidth="740"
        Background="{DynamicResource Theme.WindowBackgroundBrush}"
        Foreground="{DynamicResource Theme.TextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="SettingsTabControl" Grid.Row="0">
            <TabItem x:Name="AppearanceTabItem" Header="{services:Loc Settings.Appearance}">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.ColumnSpan="2"
                               Text="{services:Loc Settings.Theme}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="{services:Loc Settings.InterfaceTheme}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,10" />
                    <ComboBox x:Name="ThemeComboBox"
                              Grid.Row="1"
                              Grid.Column="1"
                              Width="390"
                              HorizontalAlignment="Left"
                              SelectionChanged="ThemeComboBox_SelectionChanged"
                              Margin="0,0,0,10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="350" Margin="1,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="30"
                                           Height="30"
                                           Source="{Binding Icon}"
                                           Stretch="Uniform"
                                           VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource Theme.MutedTextBrush}">
                                            <Run Text="{services:Loc Settings.AuthorLabel}" />
                                            <Run Text="{Binding Author}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Grid.Row="2"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="0,0,0,12">
                        <Button x:Name="ImportThemeButton"
                                Content="{services:Loc Settings.ImportTheme}"
                                Click="ImportTheme_Click"
                                Margin="0,0,8,0" />
                        <Button x:Name="RemoveThemeButton"
                                Content="{services:Loc Settings.RemoveTheme}"
                                Click="RemoveTheme_Click"
                                IsEnabled="False" />
                    </StackPanel>
                    <TextBlock x:Name="ThemeMetadataTextBlock"
                               Grid.Row="3"
                               Grid.Column="1"
                               Foreground="{DynamicResource Theme.MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <TextBlock x:Name="ThemeErrorsTextBlock"
                               Grid.Row="6"
                               Grid.Column="1"
                               Foreground="{DynamicResource Theme.MutedTextBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                    <ScrollViewer Grid.Row="4"
                                  Grid.Column="1"
                                  MaxHeight="84"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="0,0,0,8">
                        <TextBlock x:Name="ThemeDescriptionTextBlock"
                                   Foreground="{DynamicResource Theme.TextBrush}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                    <TextBlock Grid.Row="5"
                               Grid.Column="0"
                               Text="{services:Loc Settings.InterfaceLanguage}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,12" />
                    <ComboBox x:Name="LanguageComboBox"
                              Grid.Row="5"
                              Grid.Column="1"
                              Width="390"
                              HorizontalAlignment="Left"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Id"
                              SelectionChanged="LanguageComboBox_SelectionChanged"
                              Margin="0,0,0,12" />
                    <Border Grid.Row="7"
                            Grid.ColumnSpan="2"
                            Margin="0,14,0,0"
                            Padding="16"
                            Background="{DynamicResource Theme.WindowBackgroundBrush}"
                            BorderBrush="{DynamicResource Theme.BorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="WOSM"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="OpenStreetMap Editor"
                                       Foreground="{DynamicResource Theme.MutedTextBrush}"
                                       Margin="0,3,0,14" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{services:Loc Settings.PreviewPrimaryAction}"
                                        Background="{DynamicResource Theme.AccentBrush}"
                                        Foreground="{DynamicResource Theme.AccentTextBrush}"
                                        BorderBrush="{DynamicResource Theme.AccentBrush}"
                                        Margin="0,0,8,0" />
                                <Button Content="{services:Loc Settings.PreviewSecondaryAction}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="SourcesTabItem" Header="{services:Loc Settings.Sources}">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{services:Loc Settings.Sources}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ListBox x:Name="SourcesListBox"
                                 Grid.Row="1"
                                 DisplayMemberPath="Name"
                                 SelectionChanged="SourcesListBox_SelectionChanged" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="{services:Loc Common.Add}" Width="72" Margin="0,0,6,0" Click="AddSource_Click" />
                            <Button Content="{services:Loc Common.Delete}" Width="72" Click="RemoveSource_Click" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{services:Loc Settings.SourceName}" Margin="0,0,8,8" />
                            <TextBox x:Name="SourceNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Text="{services:Loc Settings.SourceUrl}" Margin="0,3,8,8" />
                            <TextBox x:Name="SourceUrlTextBox"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Height="72"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,8" />

                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{services:Loc Settings.MapMaxZoom}" Margin="0,0,8,8" />
                            <TextBox x:Name="MapMaxZoomTextBox" Grid.Row="2" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="{services:Loc Settings.ImageMaxZoom}" Margin="0,0,8,8" />
                            <TextBox x:Name="ImageMaxZoomTextBox" Grid.Row="3" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="{services:Loc Settings.ApiKeyToken}" Margin="0,0,8,8" />
                            <PasswordBox x:Name="AccessTokenPasswordBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Text="{services:Loc Settings.AttributionText}" Margin="0,0,8,8" />
                            <TextBox x:Name="AttributionTextBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="{services:Loc Settings.AttributionUrl}" Margin="0,0,8,8" />
                            <TextBox x:Name="AttributionUrlTextBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Top" Text="No-tile ETag" Margin="0,3,8,8" />
                            <TextBox x:Name="NoTileEtagsTextBox"
                                     Grid.Row="7"
                                     Grid.Column="1"
                                     Height="70"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,8" />

                            <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Top" Text="No-tile MD5" Margin="0,3,8,8" />
                            <TextBox x:Name="NoTileMd5sTextBox"
                                     Grid.Row="8"
                                     Grid.Column="1"
                                     Height="70"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,8" />

                            <CheckBox x:Name="VisibleCheckBox"
                                      Grid.Row="9"
                                      Grid.Column="1"
                                      Content="{services:Loc Settings.VisibleByDefault}"
                                      Margin="0,0,0,8" />

                            <CheckBox x:Name="KnownSourceCheckBox"
                                      Grid.Row="10"
                                      Grid.Column="1"
                                      Content="{services:Loc Settings.KnownSource}"
                                      Margin="0,0,0,8" />

                            <CheckBox x:Name="ExperimentalSmoothZoomCheckBox"
                                      Grid.Row="11"
                                      Grid.Column="1"
                                      Content="{services:Loc Settings.ExperimentalSmoothZoom}"
                                      Margin="0,8,0,8" />

                            <TextBlock Grid.Row="12"
                                       Grid.Column="1"
                                       Foreground="{DynamicResource Theme.MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="{services:Loc Settings.UrlHelp}" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{services:Loc Common.Cancel}" Width="88" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="{services:Loc Common.Save}" Width="88" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
