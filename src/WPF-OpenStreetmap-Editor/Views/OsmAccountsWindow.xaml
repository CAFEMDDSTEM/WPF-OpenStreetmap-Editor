<Window x:Class="WPF_OpenStreetmap_Editor.Views.OsmAccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OSM 账号" Height="460" Width="720"
        MinHeight="400" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBrush}"
        Foreground="{DynamicResource Theme.TextBrush}">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="账号" FontWeight="SemiBold" Margin="0,0,0,6" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="新建" Click="New_Click" Margin="0,0,6,0" />
                <Button Content="设为当前" Click="Activate_Click" Margin="0,0,6,0" />
                <Button Content="删除" Click="Delete_Click" />
            </StackPanel>
            <ListBox x:Name="AccountsListBox" SelectionChanged="AccountsListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="当前" Margin="8,0,0,0"
                                       Foreground="{DynamicResource Theme.AccentBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="账号名称" Margin="0,0,0,4" />
            <TextBox x:Name="DisplayNameTextBox" Grid.Row="1" Margin="0,0,0,10" />
            <StackPanel Grid.Row="2">
                <TextBlock Text="OSM API 地址" Margin="0,0,0,4" />
                <TextBox x:Name="ApiBaseUrlTextBox" Margin="0,0,0,10" />
                <TextBlock Text="OAuth 2 访问令牌" Margin="0,0,0,4" />
                <PasswordBox x:Name="AccessTokenPasswordBox" />
            </StackPanel>
            <TextBlock x:Name="StatusTextBlock" Grid.Row="3" Margin="0,10,0,0"
                       TextWrapping="Wrap" Foreground="{DynamicResource Theme.MutedTextBrush}" />
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="验证" Click="Test_Click" Margin="0,0,6,0" />
                <Button Content="保存" Click="Save_Click" Margin="0,0,6,0" />
                <Button Content="关闭" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
