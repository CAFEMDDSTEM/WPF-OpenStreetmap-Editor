<Window x:Class="WPF_OpenStreetmap_Editor.Views.OsmAccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:WPF_OpenStreetmap_Editor.Services"
        Title="{services:Loc Osm.Accounts.Title}" Height="560" Width="860"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Theme.WindowBrush}"
        Foreground="{DynamicResource Theme.TextBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView x:Name="AccountsListView" Grid.Row="0" SelectionChanged="AccountsListView_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{services:Loc Osm.Accounts.Current}" Width="56">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CurrentText}"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Theme.AccentBrush}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{services:Loc Osm.Accounts.DisplayName}" DisplayMemberBinding="{Binding DisplayName}" Width="170" />
                    <GridViewColumn Header="{services:Loc Osm.Accounts.Platform}" DisplayMemberBinding="{Binding Platform}" Width="120" />
                    <GridViewColumn Header="{services:Loc Osm.Accounts.AuthMethod}" DisplayMemberBinding="{Binding AuthenticationMethod}" Width="110" />
                    <GridViewColumn Header="{services:Loc Osm.Accounts.ApiBaseUrl}" DisplayMemberBinding="{Binding ApiBaseUrl}" Width="260" />
                    <GridViewColumn Header="{services:Loc Osm.Accounts.Credential}" DisplayMemberBinding="{Binding CredentialStatus}" Width="90" />
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{services:Loc Osm.Accounts.DisplayName}" Margin="0,0,8,8" VerticalAlignment="Center" />
            <TextBox x:Name="DisplayNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="0" Grid.Column="3" Text="{services:Loc Osm.Accounts.AuthMethod}" Margin="0,0,8,8" VerticalAlignment="Center" />
            <ComboBox x:Name="AuthenticationMethodComboBox"
                      Grid.Row="0"
                      Grid.Column="4"
                      Margin="0,0,0,8"
                      SelectionChanged="AuthenticationMethodComboBox_SelectionChanged" />

            <TextBlock x:Name="UserNameLabelTextBlock"
                       Grid.Row="1"
                       Grid.Column="0"
                       Text="{services:Loc Osm.Accounts.UserName}"
                       Margin="0,0,8,8"
                       VerticalAlignment="Center" />
            <TextBox x:Name="UserNameTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="1" Grid.Column="3" Text="{services:Loc Osm.Accounts.ApiBaseUrl}" Margin="0,0,8,8" VerticalAlignment="Center" />
            <TextBox x:Name="ApiBaseUrlTextBox" Grid.Row="1" Grid.Column="4" Margin="0,0,0,8" />

            <TextBlock x:Name="CredentialLabelTextBlock"
                       Grid.Row="2"
                       Grid.Column="0"
                       Text="{services:Loc Osm.Accounts.Password}"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center" />
            <PasswordBox x:Name="CredentialPasswordBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusTextBlock"
                       Grid.Column="0"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Theme.MutedTextBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{services:Loc Common.Add}" Click="New_Click" Margin="0,0,6,0" />
                <Button Content="{services:Loc Osm.Accounts.Test}" Click="Test_Click" Margin="0,0,6,0" />
                <Button Content="{services:Loc Common.Save}" Click="Save_Click" Margin="0,0,6,0" />
                <Button Content="{services:Loc Osm.Accounts.Activate}" Click="Activate_Click" Margin="0,0,6,0" />
                <Button Content="{services:Loc Common.Delete}" Click="Delete_Click" Margin="0,0,6,0" />
                <Button Content="{services:Loc Common.Close}" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
