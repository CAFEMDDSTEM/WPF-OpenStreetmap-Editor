<Window x:Class="WPF_OpenStreetmap_Editor.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Lucide"
        xmlns:services="clr-namespace:WPF_OpenStreetmap_Editor.Services"
        Title="{services:Loc Welcome.Title}"
        Width="760"
        Height="500"
        MinWidth="720"
        MinHeight="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackgroundBrush}"
        Foreground="{DynamicResource Theme.TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Background="{DynamicResource Theme.WindowBackgroundBrush}"
            BorderBrush="{DynamicResource Theme.BorderBrush}"
            BorderThickness="1">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{services:Loc App.Title}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionTextBlock"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource Theme.MutedTextBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="30"
                        Height="30"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="Close_Click"
                        ToolTip="{services:Loc Common.Close}">
                    <iconPacks:PackIconLucide Kind="X" Width="15" Height="15" />
                </Button>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,18,0,0"
                    Padding="14"
                    Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1">
                <TextBlock Text="{services:Loc Welcome.Warning}"
                           Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"
                           TextWrapping="Wrap"
                           LineHeight="18" />
            </Border>

            <TextBlock Grid.Row="2"
                       Margin="0,16,0,0"
                       Text="{services:Loc Welcome.Description}"
                       TextWrapping="Wrap"
                       LineHeight="18" />

            <Expander Grid.Row="3"
                      Margin="0,18,0,0"
                      Header="{services:Loc Welcome.PrivacyTitle}"
                      IsExpanded="True">
                <Border Margin="0,8,0,0"
                        Padding="12"
                        Background="{DynamicResource Theme.SurfaceAltBrush}"
                        BorderBrush="{DynamicResource Theme.BorderBrush}"
                        BorderThickness="1">
                    <CheckBox x:Name="ThirdPartyIconsCheckBox"
                              Content="{services:Loc Welcome.ShowThirdPartyIcons}"
                              Checked="ThirdPartyIconsCheckBox_Changed"
                              Unchecked="ThirdPartyIconsCheckBox_Changed" />
                </Border>
            </Expander>

            <Grid Grid.Row="5" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Height="124"
                        Margin="0,0,8,0"
                        Padding="16"
                        Click="Tutorial_Click">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <iconPacks:PackIconLucide x:Name="TutorialIcon"
                                                  Kind="BookOpen"
                                                  Width="56"
                                                  Height="56"
                                                  HorizontalAlignment="Center" />
                        <TextBlock Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   Text="{services:Loc Welcome.StartTutorial}" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1"
                        Height="124"
                        Margin="8,0,0,0"
                        Padding="16"
                        Click="EditNow_Click">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <iconPacks:PackIconLucide x:Name="EditNowIcon"
                                                  Kind="MousePointer2"
                                                  Width="56"
                                                  Height="56"
                                                  HorizontalAlignment="Center" />
                        <TextBlock Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   Text="{services:Loc Welcome.EditNow}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
