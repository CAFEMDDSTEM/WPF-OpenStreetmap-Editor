<Window x:Class="WPF_OpenStreetmap_Editor.Views.PluginsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:WPF_OpenStreetmap_Editor.Services"
        Title="{services:Loc Plugins.Title}" Height="570" Width="760"
        MinHeight="360" MinWidth="620"
        Background="{DynamicResource Theme.WindowBackgroundBrush}"
        Foreground="{DynamicResource Theme.TextBrush}"
        WindowStartupLocation="CenterOwner"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,10"
                   Text="{services:Loc Plugins.Description}"
                   TextWrapping="Wrap" />

        <DataGrid x:Name="PluginsDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="PluginsDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{services:Loc Plugins.Column.Name}" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="{services:Loc Plugins.Column.Version}" Binding="{Binding Version}" Width="*" />
                <DataGridTextColumn Header="{services:Loc Plugins.Column.Type}" Binding="{Binding Kind}" Width="*" />
                <DataGridTextColumn Header="{services:Loc Plugins.Column.Status}" Binding="{Binding StatusText}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid x:Name="PluginDetailsPanel"
              Grid.Row="2"
              Margin="0,12,0,0"
              MinHeight="92"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="72"
                    Height="72"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource Theme.BorderBrush}">
                <Image x:Name="PluginIconImage"
                       Width="64"
                       Height="64"
                       Stretch="Uniform" />
            </Border>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock x:Name="PluginDetailsTitle"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <ScrollViewer Margin="0,6,0,0"
                              MaxHeight="76"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="PluginDetailsDescription"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{services:Loc Plugins.Install}" Width="88" Margin="0,0,8,0" Click="Install_Click" />
            <Button x:Name="TrustButton"
                    Grid.Column="1"
                    Content="{services:Loc Plugins.TrustAndLoad}"
                    Width="104"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="Trust_Click" />
            <Button Grid.Column="2" Content="{services:Loc Plugins.Reload}" Width="88" Click="Reload_Click" />
            <Button Grid.Column="4" Content="{services:Loc Common.Close}" Width="88" IsCancel="True" />
        </Grid>
    </Grid>
</Window>
